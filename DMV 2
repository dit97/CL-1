   "source": [
    "# https://openweathermap.org/api/one-call-3\n",
    "# how\tHow to use api call \n",
    "# Construct the API URL\n",
    "api_url = f\"http://api.openweathermap.org/data/2.5/forecast?lat={lat}&lon={lon}&appid={api_key}\""
   ]
